/*
 * Offline deterministic end-to-end profile. The fixture tools implement only
 * the command surface used by this pipeline and never access the network.
 */

params {
    input = "${projectDir}/tests/data/e2e/samples.csv"
    fasta = "${projectDir}/tests/data/e2e/reference.fa"
    bowtie2_index = null
    outdir = "${launchDir}/results-test"
    blacklist = "${projectDir}/tests/data/e2e/blacklist.bed"
    gtf = null
    tss_bed = "${projectDir}/tests/data/e2e/tss.bed"
    motif_db = "${projectDir}/tests/data/e2e/motifs.meme"

    barcode_mismatches = 0
    allow_empty = false
    min_mapq = 5

    macs_genome_size = 4000
    macs_llocal = 100000
    macs_keep_dup = 1
    macs_broad_cutoff = 0.1
    macs_max_gap = 1000

    motif_use_narrow_peaks = true
    motif_window = 200
}

process {
    executor = 'local'
    maxForks = 1
    cpus = 1
    memory = '1 GB'
    time = '10m'
}

conda.enabled = false
docker.enabled = false
singularity.enabled = false

env {
    PATH = "${projectDir}/tests/data/e2e/fakebin:${projectDir}/bin:${System.getenv('PATH')}"
    LC_ALL = 'C'
    LANG = 'C'
    PYTHONDONTWRITEBYTECODE = '1'
}
