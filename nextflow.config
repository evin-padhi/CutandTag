/*
 * Runtime defaults for the bulk nano-CUT&Tag workflow.  Process modules attach
 * one of the resource labels below and declare a matching repository-local
 * environment with `conda "${projectDir}/envs/<tool>.yml"`.
 */

manifest.nextflowVersion = '>=23.10.0'

params {
    input                    = null
    fasta                    = null
    bowtie2_index            = null
    outdir                   = 'results'
    blacklist                = null
    gtf                      = null
    tss_bed                  = null
    motif_db                 = null

    barcode_mismatches       = 0
    allow_empty              = false
    min_mapq                 = 5

    macs_genome_size         = null
    macs_llocal              = 100000
    macs_keep_dup            = 1
    macs_broad_cutoff        = 0.1
    macs_max_gap             = 1000

    motif_use_narrow_peaks   = true
    motif_window             = 200
}

process {
    executor = 'local'
    errorStrategy = 'terminate'

    withLabel: process_light {
        cpus = 1
        memory = '4 GB'
        time = '4h'
    }

    withLabel: process_standard {
        cpus = 2
        memory = '8 GB'
        time = '12h'
    }

    withLabel: process_heavy {
        cpus = 4
        memory = '16 GB'
        time = '24h'
    }
}

conda {
    enabled = false
    cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${launchDir}/.nextflow-conda"
}

docker {
    enabled = false
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,cpus,memory'
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
}

workflow.onComplete = {
    if (workflow.success) {
        println(
            "Bulk nano-CUT&Tag pipeline completed successfully. " +
            "Results: ${params.outdir}"
        )
    }
}

workflow.onError = {
    println(
        "Bulk nano-CUT&Tag pipeline failed: " +
        "${workflow.errorMessage ?: 'unknown error'}"
    )
}

profiles {
    conda {
        conda.enabled = true
        docker.enabled = false
    }

    docker {
        conda.enabled = false
        docker.enabled = true
        // Per-process BioContainers images are added with their modules.
    }

    test {
        includeConfig 'conf/test.config'
        process.executor = 'local'
        process.maxForks = 1
        conda.enabled = false
        docker.enabled = false
    }
}
